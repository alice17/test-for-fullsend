{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ci-diagnose-result.schema.json",
  "$comment": "Generated by Cursor",
  "title": "CI Diagnose Agent Result",
  "description": "Structured output from the ci-diagnose agent for GitHub Actions checks. Validated by the harness before the post-script runs (ADR 0022).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "classification",
    "confidence",
    "recommended_action",
    "failures",
    "retry_targets",
    "pr_comment_markdown",
    "reasoning"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["diagnosed", "needs_human", "error"],
      "description": "Overall agent outcome."
    },
    "classification": {
      "type": "string",
      "enum": ["flaky", "infra", "code", "unknown"],
      "description": "Primary failure class across observed failing checks."
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Confidence in classification and recommended_action (0.0–1.0)."
    },
    "recommended_action": {
      "type": "string",
      "enum": ["retry", "comment_only", "escalate"],
      "description": "What the post-script should do. retry only when classification is flaky."
    },
    "failures": {
      "type": "array",
      "description": "Per-check diagnosis details.",
      "items": {
        "$ref": "#/$defs/failure"
      }
    },
    "retry_targets": {
      "type": "array",
      "description": "Check runs to re-run when recommended_action is retry.",
      "items": {
        "$ref": "#/$defs/retry_target"
      }
    },
    "pr_comment_markdown": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16384,
      "description": "Markdown body the post-script posts on the PR."
    },
    "reasoning": {
      "type": "string",
      "minLength": 1,
      "description": "Internal reasoning for classification and action choice."
    },
    "error_message": {
      "type": "string",
      "description": "Required when status is error."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "status": { "const": "error" } },
        "required": ["status"]
      },
      "then": {
        "required": ["error_message"]
      }
    },
    {
      "if": {
        "properties": { "recommended_action": { "const": "retry" } },
        "required": ["recommended_action"]
      },
      "then": {
        "properties": {
          "classification": { "const": "flaky" },
          "retry_targets": { "minItems": 1 }
        }
      }
    }
  ],
  "$defs": {
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "check_name",
        "conclusion",
        "classification",
        "confidence",
        "root_cause",
        "evidence"
      ],
      "properties": {
        "check_name": {
          "type": "string",
          "minLength": 1
        },
        "check_run_id": {
          "type": ["integer", "null"],
          "description": "GitHub check run ID when available."
        },
        "conclusion": {
          "type": "string",
          "minLength": 1,
          "description": "Check conclusion (e.g. failure, timed_out, cancelled)."
        },
        "details_url": {
          "type": ["string", "null"]
        },
        "workflow_run_url": {
          "type": ["string", "null"],
          "description": "GitHub Actions workflow run URL when available."
        },
        "workflow_run_id": {
          "type": ["integer", "null"],
          "description": "GitHub Actions workflow run ID when available."
        },
        "job_name": {
          "type": ["string", "null"],
          "description": "GitHub Actions job name when distinct from check_name."
        },
        "classification": {
          "type": "string",
          "enum": ["flaky", "infra", "code", "unknown"],
          "description": "Per-failure classification."
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Per-failure confidence in classification (0.0–1.0)."
        },
        "root_cause": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Short log/event excerpts supporting the root cause."
        }
      }
    },
    "retry_target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["check_name"],
      "properties": {
        "check_name": {
          "type": "string",
          "minLength": 1
        },
        "check_run_id": {
          "type": ["integer", "null"]
        }
      }
    }
  }
}
